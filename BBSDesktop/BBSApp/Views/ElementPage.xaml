<Page
    x:Class="BBSApp.Views.ElementPage"
    SizeChanged="Page_SizeChanged"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BBSApp.Controls"
    xmlns:hcw="using:Hcw.Ui.Controls"
    Background="Transparent">

    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- H1 page title — flat -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="GenerateBtn" Content="Generate BBS" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Generate_Click" AutomationProperties.Name="Generate"/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False"/>

        <Pivot x:Name="MainPivot" Grid.Row="2" SelectionChanged="MainPivot_SelectionChanged">
            <PivotItem x:Name="EntryPivotItem" Header="Entry">
                <Grid Padding="0,10,0,0" RowSpacing="10" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="SketchColumn" Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sheet toolbar -->
                    <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <hcw:FlexBar Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SheetTitleText" Text="Sheet" Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="FloorCombo" MinWidth="140"
                                      PlaceholderText="Floor"
                                      SelectionChanged="FloorCombo_SelectionChanged"
                                      AutomationProperties.Name="Floor filter"
                                      ToolTipService.ToolTip="Show and edit rows for this floor only"/>
                            <TextBlock x:Name="ClearHeightText" Style="{StaticResource CaptionSecondaryStyle}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="CountText" Style="{StaticResource CaptionSecondaryStyle}"
                                       VerticalAlignment="Center"/>
                        </hcw:FlexBar>
                        <TextBlock x:Name="EditHint" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource MetaTextStyle}"
                                   Text="Click a cell to type · Enter = next column · Enter twice = next row"/>
                        <TextBlock x:Name="ComputedHint" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource MetaTextStyle}"
                                   Visibility="Collapsed"
                                   Text="Formwork from RCC — edit Include column, then Save include or Refresh"/>
                        <hcw:FlexBar Grid.Row="2" Grid.ColumnSpan="2">
                            <Button x:Name="NewBtn" Content="Add row" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="New_Click" ToolTipService.ToolTip="Add blank row (Ctrl+N)"/>
                            <Button x:Name="DuplicateBtn" Content="Duplicate row" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Duplicate_Click"
                                    ToolTipService.ToolTip="Copy the selected row's values into a new row below (Ctrl+D)">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="D"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button x:Name="DeleteBtn" Content="Delete row" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Delete_Click" ToolTipService.ToolTip="Delete selected row"/>
                            <Button x:Name="SaveBtn" Content="Save include" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Save_Click" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Save Include Yes/No for shuttering"/>
                            <Button x:Name="UndoBtn" Content="Reload row" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Undo_Click" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Reload selected row into detail form"/>
                            <Button x:Name="RefreshComputedBtn" Content="Refresh from RCC"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RefreshComputed_Click" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Recalculate formwork from concrete members"/>
                            <Button x:Name="FinalizeFinishBtn" Content="Finalize finishes"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="FinalizeFinish_Click" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Write included areas to Plaster + Painting for BOQ"/>
                        </hcw:FlexBar>
                    </Grid>

                    <!-- Excel-style sheet: suite tokens (follows dark/light) -->
                    <Border x:Name="SheetBorder" Grid.Row="1" Padding="0"
                            Background="{ThemeResource HcwWhiteBrush}"
                            BorderBrush="{ThemeResource HcwEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer x:Name="SheetHScroll"
                                      Background="{ThemeResource HcwWhiteBrush}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      SizeChanged="SheetHScroll_SizeChanged">
                            <Grid x:Name="SheetWide" Background="{ThemeResource HcwWhiteBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{ThemeResource HcwEdgeBrush}" BorderThickness="0,0,0,1"
                                        Background="{ThemeResource HcwSoftBrush}">
                                    <Grid x:Name="SheetHeader"/>
                                </Border>
                                <ScrollViewer x:Name="SheetVScroll" Grid.Row="1"
                                              Background="{ThemeResource HcwWhiteBrush}"
                                              VerticalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Disabled"
                                              AutomationProperties.Name="Element datasheet">
                                    <StackPanel x:Name="SheetRowsHost" Background="{ThemeResource HcwWhiteBrush}"/>
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Section sketch (RCC only) -->
                    <StackPanel x:Name="SketchPanel" Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="Section sketch" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,2"/>
                        <Border Style="{StaticResource FluentCardStyle}" Padding="10,8"
                                VerticalAlignment="Top">
                            <local:SectionDiagram x:Name="Diagram"
                                                  AutomationProperties.Name="Member section sketch"/>
                        </Border>
                    </StackPanel>

                    <!-- Optional detail form + extras -->
                    <Expander Grid.Row="2" Grid.ColumnSpan="2"
                              Header="Row detail &amp; extras (bars, advanced fields)"
                              IsExpanded="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="12" Padding="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FluentCardStyle}" Padding="12,8,12,10">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="FormHost"/>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" Width="160">
                                <ComboBox x:Name="RecordCombo" MinWidth="160"
                                          PlaceholderText="Jump to row…"
                                          SelectionChanged="RecordCombo_SelectionChanged"
                                          AutomationProperties.Name="Record selector"/>
                                <Button Content="Apply form → row" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Save_Click"
                                        ToolTipService.ToolTip="Write detail form values into the selected sheet row"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="DeductionsPivotItem" Header="Deductions" Visibility="Collapsed">
                <Grid Padding="0,10,0,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="One opening type per line · same wall can appear again · Nos = identical openings"
                                   Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Add opening" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddOpening_Click"
                                    ToolTipService.ToolTip="Add another opening line (pick wall mark)"/>
                            <Button Content="Delete line" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DeleteOpening_Click"
                                    ToolTipService.ToolTip="Delete selected opening line"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Padding="0"
                            Background="{ThemeResource HcwWhiteBrush}"
                            BorderBrush="{ThemeResource HcwEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <Grid Background="{ThemeResource HcwWhiteBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{ThemeResource HcwEdgeBrush}" BorderThickness="0,0,0,1"
                                        Background="{ThemeResource HcwSoftBrush}">
                                    <Grid x:Name="DeductSheetHeader"/>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="DeductSheetRowsHost" Background="{ThemeResource HcwWhiteBrush}"/>
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="FinalPivotItem" Header="Final" Visibility="Collapsed">
                <Grid Padding="0,10,0,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FinalSummaryText" Style="{StaticResource MetaTextStyle}"
                               Text="Finalize writes included reconcile lines to Plaster. Painting qty is taken from plaster."/>
                    <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="4">
                        <Border x:Name="FinalTableHost"/>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem Header="Results">
                <Grid Padding="0,10,0,0" ColumnSpacing="{StaticResource SectionGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Bar bending schedule" Style="{StaticResource SectionHeaderStyle}"/>
                            <Button Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right" Click="ExportBbs_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                            <Border x:Name="BbsHost"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Steel summary" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Click="ExportSum_Click"/>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                                <Border x:Name="SummaryHost"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" RowSpacing="4" MinHeight="140">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Checks / notes" Style="{StaticResource SectionHeaderStyle}"/>
                            <Border x:Name="ChecksPanel" Grid.Row="1" Style="{StaticResource FluentLayerStyle}" Padding="8">
                                <Border x:Name="ChecksHost"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
