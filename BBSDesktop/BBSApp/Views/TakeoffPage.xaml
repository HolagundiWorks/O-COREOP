<Page
    x:Class="BBSApp.Views.TakeoffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BBSApp.Controls"
    xmlns:hcw="using:Hcw.Ui.Controls"
    Background="Transparent">
    <Grid x:Name="RootGrid" Style="{StaticResource PageRootStyle}" ColumnSpacing="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightCol" Width="280"/>
            <ColumnDefinition x:Name="RightRailCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Band 1: page header — title + primary actions -->
        <Grid x:Name="TopBar" Grid.Row="0" Grid.ColumnSpan="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Drawing takeoff" Style="{StaticResource PageTitleStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="ModeStatus" Style="{StaticResource CaptionSecondaryStyle}"/>
                    <TextBlock x:Name="AutoCodePreview" Style="{StaticResource MetaTextStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Import PDF" Click="ImportPdf_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Commit to BOQ" Click="Commit_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Delete" Click="Delete_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="ToggleRightBtn" Click="ToggleRightPanel_Click" Width="32" Height="28" Padding="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTipService.ToolTip="Show / hide panels"
                        AutomationProperties.Name="Show or hide panels">
                    <FontIcon x:Name="ToggleRightIcon" Glyph="&#xE89F;" FontSize="14"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </Button>
                <Button x:Name="FullscreenBtn" Content="Fullscreen" Click="Fullscreen_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="F11 — expand drawing (Esc to exit)"/>
                <Button Content="Window" Click="WindowFullscreen_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Window fullscreen"/>
            </StackPanel>
        </Grid>

        <!-- Band 2: tool strip — Elements | Draw | View -->
        <Border x:Name="ElementBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="10,8"
                CornerRadius="{StaticResource RadiusLarge}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <hcw:FlexBar VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="ELEMENTS" Style="{StaticResource ToolbarLabelStyle}"/>
                            <StackPanel x:Name="ElementToolPanel" Orientation="Horizontal" Spacing="2"/>
                        </StackPanel>
                        <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="DRAW" Style="{StaticResource ToolbarLabelStyle}"/>
                            <StackPanel x:Name="UtilToolPanel" Orientation="Horizontal" Spacing="2"/>
                        </StackPanel>
                        <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="VIEW" Style="{StaticResource ToolbarLabelStyle}"/>
                            <Button x:Name="ScaleToolBtn" Content="Set scale" Click="ScaleTool_Click"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Snap two points on a known size, then enter mm"/>
                            <TextBlock x:Name="ScaleLabel" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" Margin="4,0,0,0"/>
                            <ComboBox x:Name="LevelCombo" MinWidth="140" PlaceholderText="Floor / Level" AutomationProperties.Name="Floor or level"
                                      SelectionChanged="Level_Changed" VerticalAlignment="Center"/>
                            <StackPanel x:Name="ViewExtrasPanel" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="Prev" Click="PrevPage_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Next" Click="NextPage_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                                <TextBlock x:Name="PageLabel" VerticalAlignment="Center"
                                           Style="{StaticResource MetaTextStyle}" MinWidth="72"/>
                                <Button Content="Zoom −" Click="ZoomOut_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Zoom +" Click="ZoomIn_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                            </StackPanel>
                            <Button x:Name="ViewMoreBtn" Content="View…" Style="{StaticResource ToolbarButtonStyle}"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Previous page" Click="PrevPage_Click"/>
                                        <MenuFlyoutItem Text="Next page" Click="NextPage_Click"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Zoom −" Click="ZoomOut_Click"/>
                                        <MenuFlyoutItem Text="Zoom +" Click="ZoomIn_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel></hcw:FlexBar>
                <Button x:Name="FinishShapeBtn" Grid.Column="1" Content="Finish shape"
                        Click="FinishShape_Click" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Band 3: workspace — canvas dominant -->
        <Border x:Name="CanvasBorder" Grid.Row="2" Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Background="#FF2A2A2A"
                CornerRadius="{StaticResource RadiusLarge}">
            <Grid>
                <ScrollViewer x:Name="HostScroll" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <controls:TakeoffCanvas x:Name="CanvasHost"/>
                </ScrollViewer>
                <Border x:Name="FullscreenChrome" Visibility="Collapsed"
                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Background="#CC1A1A1A" Padding="10,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Exit fullscreen" Click="Fullscreen_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Set scale" Click="ScaleTool_Click"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Zoom −" Click="ZoomOut_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Zoom +" Click="ZoomIn_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Commit" Click="Commit_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <TextBlock x:Name="FsModeStatus" VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongStyle}" Foreground="White"/>
                            <TextBlock x:Name="FsScaleLabel" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionSecondaryStyle}" Foreground="#CCFFFFFF"/>
                        </StackPanel>
                        <TextBlock Text="Esc or F11 to exit" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource MetaTextStyle}" Foreground="#99FFFFFF"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right dock: Layers (H2) + Items (H2) -->
        <Border x:Name="RightPanel" Grid.Row="2" Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Grid Padding="10,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LayerCollapseBtn" Click="LayerManagerCollapse_Click" AutomationProperties.Name="Layers, show or hide the list"
                                    Background="Transparent" BorderThickness="0" Padding="2,2"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="LayerChevron" Glyph="&#xE70D;" FontSize="12"/>
                                    <TextBlock Text="Layers" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Content="All on" Click="LayersAllOn_Click"
                                    Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" Content="All off" Click="LayersAllOff_Click"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                        </Grid>
                        <Border x:Name="LayerManagerBody" Padding="6,4,6,8">
                            <StackPanel>
                                <Grid Padding="6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="On" Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Clr" Style="{StaticResource MetaTextStyle}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource MetaTextStyle}"/>
                                </Grid>
                                <StackPanel x:Name="LayerListPanel" Spacing="1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Padding="10,10,10,8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Takeoff items" Style="{StaticResource SectionHeaderStyle}"/>
                    <ListView x:Name="ItemList" Grid.Row="1" SelectionChanged="ItemList_SelectionChanged"
                              AutomationProperties.Name="Pending takeoff items">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="4,6">
                                    <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource BodyStrongStyle}"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}" Style="{StaticResource CaptionSecondaryStyle}"/>
                                    <TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource MetaTextStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="RightRail" Grid.Row="2" Grid.Column="2"
                Visibility="Collapsed" Width="36"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}">
            <Button Click="ToggleRightPanel_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    ToolTipService.ToolTip="Show / hide panels"
                    AutomationProperties.Name="Show or hide panels">
                <FontIcon Glyph="&#xE89F;" FontSize="16"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
            </Button>
        </Border>
    </Grid>
</Page>
