<Page
    x:Class="BBSApp.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:local="using:BBSApp.Controls"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Project schedule" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Critical Path Method scheduler — activities, network, and Gantt."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <CalendarDatePicker x:Name="StartDatePicker" Header="Start date" DateChanged="StartDate_Changed" MinWidth="150"/>
            <ComboBox x:Name="WorkWeekBox" Header="Working week" SelectionChanged="WorkWeek_Changed" MinWidth="150">
                <ComboBoxItem Content="7 days (calendar)" Tag="7"/>
                <ComboBoxItem Content="6 days (no Sun)" Tag="6"/>
                <ComboBoxItem Content="5 days (no Sat/Sun)" Tag="5"/>
            </ComboBox>
            <Button Content="Add activity" Click="Add_Click" AutomationProperties.Name="Add schedule activity" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Delete" Click="Delete_Click" AutomationProperties.Name="Delete schedule activity" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Seed from project" Click="Seed_Click" AutomationProperties.Name="Seed schedule from project" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Recalculate" Click="Recalc_Click" AutomationProperties.Name="Recalculate schedule" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Export PDF" Click="ExportPdf_Click" AutomationProperties.Name="Export schedule PDF" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
        </StackPanel>

        <Pivot Grid.Row="2" x:Name="SchedulePivot" SelectionChanged="Pivot_Changed">
            <PivotItem Header="Activities">
                <controls:DataGrid x:Name="ActivityGrid"
                                   AutoGenerateColumns="False"
                                   CanUserSortColumns="False"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   SelectionMode="Single"
                                   CellEditEnded="ActivityGrid_CellEditEnded"
                                   IsReadOnly="False">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="#" Binding="{Binding IndexText}" IsReadOnly="True" Width="40"/>
                        <controls:DataGridTextColumn Header="Activity" Binding="{Binding Name, Mode=TwoWay}" Width="2*"/>
                        <controls:DataGridTextColumn Header="Dur (d)" Binding="{Binding DurationText, Mode=TwoWay}" Width="70"/>
                        <controls:DataGridTextColumn Header="Predecessors" Binding="{Binding PredecessorsText, Mode=TwoWay}" Width="140"/>
                        <controls:DataGridTextColumn Header="%" Binding="{Binding PercentText, Mode=TwoWay}" Width="55"/>
                        <controls:DataGridTextColumn Header="Start" Binding="{Binding StartText}" IsReadOnly="True" Width="90"/>
                        <controls:DataGridTextColumn Header="Finish" Binding="{Binding FinishText}" IsReadOnly="True" Width="90"/>
                        <controls:DataGridTextColumn Header="Float" Binding="{Binding FloatText}" IsReadOnly="True" Width="60"/>
                        <controls:DataGridTextColumn Header="Critical" Binding="{Binding CriticalText}" IsReadOnly="True" Width="70"/>
                        <controls:DataGridTextColumn Header="WBS" Binding="{Binding Wbs, Mode=TwoWay}" Width="*"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </PivotItem>

            <PivotItem Header="Network (CPM/PERT)">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Drag a node to move it · drag from the dot on a node's right edge onto another node to link (Finish→Start) · click a node then Delete link."/>
                        <Button Content="Delete link into selected" Click="DeleteLink_Click" AutomationProperties.Name="Delete link into selected activity" Style="{StaticResource ToolbarButtonStyle}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Enabled"
                                  MinZoomFactor="0.4" MaxZoomFactor="2.5">
                        <local:NetworkCanvas x:Name="Network"/>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Gantt">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Zoom −" Click="GanttZoomOut_Click" AutomationProperties.Name="Zoom out Gantt chart" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button Content="Zoom +" Click="GanttZoomIn_Click" AutomationProperties.Name="Zoom in Gantt chart" Style="{StaticResource ToolbarButtonStyle}"/>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Red = critical path · dashed whisker = total float · green line = today."/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
                        <local:GanttChart x:Name="Gantt"/>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
