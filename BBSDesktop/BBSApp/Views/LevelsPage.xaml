<Page
    x:Class="BBSApp.Views.LevelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SectionGap}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Story settings" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Storeys are listed top to bottom. Elevation is slab level (mm). Height to next is floor-to-floor. Plinth stays Lvl0."/>
        </StackPanel>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
            <Button x:Name="InsertAboveBtn" Content="Insert Above" Style="{StaticResource SecondaryButtonStyle}" Click="InsertAbove_Click"/>
            <Button x:Name="InsertBelowBtn" Content="Insert Below" Style="{StaticResource SecondaryButtonStyle}" Click="InsertBelow_Click"/>
            <Button x:Name="DeleteStoryBtn" Content="Delete Story" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteStory_Click"/>
            <Button Content="Apply ℓ to columns" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyColumns_Click"
                    AutomationProperties.Name="Apply clear height to columns"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Padding="12,8,12,4" Margin="0,0,0,-4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="No." Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Elevation" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Height to Next" Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Show" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           ToolTipService.ToolTip="Show level marker"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="12,0,12,8">
            <ListView x:Name="StoryList"
                      SelectionMode="Single"
                      SelectionChanged="StoryList_SelectionChanged"
                      AutomationProperties.Name="Story levels">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding StoryNo}" VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongStyle}"/>
                            <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" VerticalAlignment="Center"
                                     PlaceholderText="Storey name" LostFocus="StoryField_LostFocus"/>
                            <NumberBox Grid.Column="3" Value="{Binding ElevationMm, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                       Minimum="-1000000" Maximum="1000000" VerticalAlignment="Center"
                                       ValueChanged="StoryNumber_ValueChanged"/>
                            <NumberBox Grid.Column="4" Value="{Binding HeightToNextMm, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                       Minimum="0" Maximum="1000000" VerticalAlignment="Center"
                                       ValueChanged="StoryNumber_ValueChanged"/>
                            <CheckBox Grid.Column="5" IsChecked="{Binding ShowMarker, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="Show level marker"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel x:Name="StructurePanel" Grid.Row="5" Spacing="8" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Structure (selected storey)" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid ColumnSpacing="{StaticResource SpacingM}" MaxWidth="640">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="SlabBox" Header="Slab D (mm)" SpinButtonPlacementMode="Compact" Minimum="0"
                           ValueChanged="Structure_ValueChanged"/>
                <NumberBox Grid.Column="1" x:Name="BeamBox" Header="Beam D (mm)" SpinButtonPlacementMode="Compact" Minimum="0"
                           ValueChanged="Structure_ValueChanged"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock Text="Clear ht ℓ" Style="{StaticResource CaptionSecondaryStyle}"/>
                    <TextBlock x:Name="ClearHeightText" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
