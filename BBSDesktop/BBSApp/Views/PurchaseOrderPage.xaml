<Page
    x:Class="BBSApp.Views.PurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Purchase orders" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Steel from BBS · concrete by grade (RMC or site batch) · civil materials (bricks, mortar, etc.). Quantities only — no rates."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click"
                        AutomationProperties.Name="Refresh purchase orders"/>
                <Button Content="Export PDF" Style="{StaticResource AccentButtonStyle}"
                        Click="ExportPdf_Click" AutomationProperties.Name="Export purchase order PDF"/>
                <Button Content="Steel CSV" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportSteel_Click" AutomationProperties.Name="Export steel CSV"/>
                <Button Content="Materials CSV" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportMat_Click" AutomationProperties.Name="Export materials CSV"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Storeys" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Style="{StaticResource FluentCardCompactStyle}">
                <Grid ColumnSpacing="{StaticResource SpacingM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LevelChecks" Orientation="Horizontal" Spacing="8"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton MinHeight="28" MinWidth="40" Content="All" Click="SelectAllLevels_Click"/>
                        <HyperlinkButton MinHeight="28" MinWidth="40" Content="None" Click="SelectNoLevels_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource FluentCardCompactStyle}">
            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="RmcToggle"
                              Header="Concrete from RMC"
                              OffContent="Site batch (cement / sand / agg split)"
                              OnContent="RMC by grade (no cement–sand–agg for RCC)"
                              Toggled="RmcToggle_Toggled"
                              AutomationProperties.Name="Concrete from RMC"/>
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                           TextWrapping="Wrap"
                           Text="When RMC is on, materials PO skips RCC cement/sand/aggregate — order concrete as m³ by grade. Civil mortar / bricks / blocks still appear."/>
            </StackPanel>
        </Border>

        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False"/>

        <Grid Grid.Row="4" ColumnSpacing="{StaticResource SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SteelTitle" Text="Steel purchase order"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="SteelHost"/>
                </Border>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="GradeTitle" Text="Concrete by grade"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="GradeHost"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" ColumnSpacing="{StaticResource SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ConcreteTitle" Text="Concrete by element"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="ConcreteHost"/>
                </Border>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="MatTitle" Text="Other materials"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="MatHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
