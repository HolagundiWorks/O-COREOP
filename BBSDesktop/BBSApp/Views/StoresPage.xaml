<Page
    x:Class="BBSApp.Views.StoresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Procurement &amp; stores" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Purchase orders, goods receipt, inventory, and masters."/>
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="MainPivot" SelectionChanged="Pivot_Changed">
            <!-- Purchase orders -->
            <PivotItem Header="Purchase orders">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="New PO" Click="NewPo_Click" AutomationProperties.Name="New purchase order" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Save" Click="SavePo_Click" AutomationProperties.Name="Save purchase order" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Place &amp; number" Click="PlacePo_Click" AutomationProperties.Name="Place and number purchase order" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Export PDF" Click="ExportPo_Click" AutomationProperties.Name="Export purchase order PDF" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeletePo_Click" AutomationProperties.Name="Delete purchase order" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBox x:Name="PrefixBox" Header="Doc prefix" Width="110" PlaceholderText="auto" LostFocus="Prefix_LostFocus"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                            <ListView x:Name="PoList" SelectionMode="Single" SelectionChanged="PoList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Padding="2,4">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PoEditor" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="PoDateBox" Grid.Column="0" Header="Date" MinWidth="140"/>
                                        <ComboBox x:Name="PoSupplierBox" Grid.Column="1" Header="Supplier" HorizontalAlignment="Stretch"
                                                  SelectionChanged="PoSupplier_Changed"/>
                                        <ComboBox x:Name="PoWarehouseBox" Grid.Column="2" Header="Deliver to" HorizontalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Number" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <TextBlock x:Name="PoNumberText" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Materials" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Add line" Click="AddPoLine_Click" AutomationProperties.Name="Add purchase order line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Delete line" Click="DeletePoLine_Click" AutomationProperties.Name="Delete purchase order line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:DataGrid x:Name="PoLinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                           SelectionMode="Single" MinHeight="150" MaxHeight="260" CellEditEnded="PoLines_CellEditEnded">
                                            <controls:DataGrid.Columns>
                                                <controls:DataGridTextColumn Header="Material" Binding="{Binding Material, Mode=TwoWay}" Width="2*"/>
                                                <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="70"/>
                                                <controls:DataGridTextColumn Header="Qty" Binding="{Binding QtyText, Mode=TwoWay}" Width="90"/>
                                                <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="90"/>
                                                <controls:DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" IsReadOnly="True" Width="110"/>
                                            </controls:DataGrid.Columns>
                                        </controls:DataGrid>
                                        <TextBlock x:Name="PoTotalText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Total: 0.00"/>
                                    </StackPanel>
                                    <TextBox x:Name="PoNotesBox" Header="Notes / terms" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <InfoBar x:Name="PoLockBar" IsOpen="False" IsClosable="False" Severity="Success"
                                             Title="Placed" Message="This PO is placed and numbered. Editing is locked; use Export PDF or raise a GRN."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- GRN -->
            <PivotItem Header="Goods receipt (GRN)">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="New GRN" Click="NewGrn_Click" AutomationProperties.Name="New goods receipt note" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Save" Click="SaveGrn_Click" AutomationProperties.Name="Save goods receipt note" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Receive &amp; number" Click="ReceiveGrn_Click" AutomationProperties.Name="Receive and number goods receipt" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeleteGrn_Click" AutomationProperties.Name="Delete goods receipt note" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                            <ListView x:Name="GrnList" SelectionMode="Single" SelectionChanged="GrnList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Padding="2,4">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="GrnEditor" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="GrnDateBox" Grid.Column="0" Header="Date" MinWidth="140"/>
                                        <ComboBox x:Name="GrnPoBox" Grid.Column="1" Header="Against PO" HorizontalAlignment="Stretch"
                                                  SelectionChanged="GrnPo_Changed"/>
                                        <ComboBox x:Name="GrnWarehouseBox" Grid.Column="2" Header="Store" HorizontalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Number" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <TextBlock x:Name="GrnNumberText" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="GrnSupplierBox" Header="Supplier"/>
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Received materials" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Add line" Click="AddGrnLine_Click" AutomationProperties.Name="Add goods receipt line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Delete line" Click="DeleteGrnLine_Click" AutomationProperties.Name="Delete goods receipt line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:DataGrid x:Name="GrnLinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                           SelectionMode="Single" MinHeight="150" MaxHeight="280" CellEditEnded="GrnLines_CellEditEnded">
                                            <controls:DataGrid.Columns>
                                                <controls:DataGridTextColumn Header="Material" Binding="{Binding Material, Mode=TwoWay}" Width="2*"/>
                                                <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="70"/>
                                                <controls:DataGridTextColumn Header="Qty received" Binding="{Binding QtyText, Mode=TwoWay}" Width="110"/>
                                                <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="90"/>
                                            </controls:DataGrid.Columns>
                                        </controls:DataGrid>
                                    </StackPanel>
                                    <InfoBar x:Name="GrnLockBar" IsOpen="False" IsClosable="False" Severity="Success"
                                             Title="Received" Message="This GRN is received and added to stock. Editing is locked."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Inventory -->
            <PivotItem Header="Inventory">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Refresh" Click="RefreshInventory_Click" AutomationProperties.Name="Refresh inventory" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Issue material" Click="IssueMaterial_Click" AutomationProperties.Name="Issue material" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Stock = received (GRNs) − issued."/>
                    </StackPanel>
                    <controls:DataGrid Grid.Row="1" x:Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                            <controls:DataGridTextColumn Header="Store" Binding="{Binding Warehouse}" Width="*"/>
                            <controls:DataGridTextColumn Header="Received" Binding="{Binding ReceivedText}" Width="120"/>
                            <controls:DataGridTextColumn Header="Issued" Binding="{Binding IssuedText}" Width="120"/>
                            <controls:DataGridTextColumn Header="In stock" Binding="{Binding InStockText}" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Masters -->
            <PivotItem Header="Masters">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Suppliers" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                            <Button Content="Add" Click="AddSupplier_Click" AutomationProperties.Name="Add supplier" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Delete" Click="DeleteSupplier_Click" AutomationProperties.Name="Delete supplier" Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>
                        <controls:DataGrid Grid.Row="1" x:Name="SuppliersGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="2*"/>
                                <controls:DataGridTextColumn Header="Contact" Binding="{Binding Contact, Mode=TwoWay}" Width="*"/>
                                <controls:DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin, Mode=TwoWay}" Width="140"/>
                                <controls:DataGridTextColumn Header="Address" Binding="{Binding Address, Mode=TwoWay}" Width="2*"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Warehouses / stores" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                            <Button Content="Add" Click="AddWarehouse_Click" AutomationProperties.Name="Add warehouse" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Delete" Click="DeleteWarehouse_Click" AutomationProperties.Name="Delete warehouse" Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>
                        <controls:DataGrid Grid.Row="1" x:Name="WarehousesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="2*"/>
                                <controls:DataGridTextColumn Header="Location" Binding="{Binding Location, Mode=TwoWay}" Width="2*"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
