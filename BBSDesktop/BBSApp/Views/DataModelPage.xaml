<Page
    x:Class="BBSApp.Views.DataModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Item relationships" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleStyle}"
                           Text="Each item with its unit and rate, what feeds it (inputs) and what it produces (outputs)."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ViewCombo" MinWidth="180" VerticalAlignment="Center"
                          SelectionChanged="ViewCombo_SelectionChanged"
                          AutomationProperties.Name="View">
                    <ComboBoxItem Content="Relationships" Tag="relationships" IsSelected="True"/>
                    <ComboBoxItem Content="Definitions" Tag="definitions"/>
                </ComboBox>
                <Button Content="Edit in O-Dynamo" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OpenDynamo_Click" AutomationProperties.Name="Edit the item links visually in O-Dynamo"
                        ToolTipService.ToolTip="Open the items and their link rules as a graph in O-Dynamo. Save there to apply the links here."/>
                <Button Content="Export ERD" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportSchema_Click" AutomationProperties.Name="Export the ERD as DBML and SQL"
                        ToolTipService.ToolTip="Regenerate the logical ERD (aqc-core.dbml + .sql) for dbdiagram.io."/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"/>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="8">
            <Border x:Name="TableHost"/>
        </Border>
    </Grid>
</Page>
