<Page
    x:Class="BBSApp.Views.ContractsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Contracts &amp; tendering" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Work orders, tenders, schedule of rates and standard terms. Numbers assigned on finalize."/>
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="MainPivot" SelectionChanged="Pivot_Changed">
            <!-- Contracts -->
            <PivotItem Header="Contracts / Work orders">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="NewKindBox" Header="New" MinWidth="180"/>
                        <Button Content="New" Click="NewContract_Click" AutomationProperties.Name="New contract" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Save" Click="SaveContract_Click" AutomationProperties.Name="Save contract" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Finalize &amp; number" Click="FinalizeContract_Click" AutomationProperties.Name="Finalize and number contract" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Export PDF" Click="ExportContract_Click" AutomationProperties.Name="Export contract PDF" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Delete" Click="DeleteContract_Click" AutomationProperties.Name="Delete contract" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <TextBox x:Name="PrefixBox" Header="Doc prefix" Width="110" PlaceholderText="auto"
                                 LostFocus="Prefix_LostFocus" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                            <ListView x:Name="ContractList" SelectionMode="Single" SelectionChanged="ContractList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Padding="2,4">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="EditorPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="KindBox" Grid.Column="0" Header="Type" HorizontalAlignment="Stretch"
                                                  SelectionChanged="KindBox_SelectionChanged"/>
                                        <CalendarDatePicker x:Name="AwardBox" Grid.Column="1" Header="Award date" MinWidth="140"/>
                                        <CalendarDatePicker x:Name="CompletionBox" Grid.Column="2" Header="Completion" MinWidth="140"/>
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Number" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <TextBlock x:Name="NumberText" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox x:Name="TitleBox" Header="Title / work"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ContractorNameBox" Grid.Column="0" Header="Contractor / agency"/>
                                        <NumberBox x:Name="RetentionBox" Grid.Column="1" Header="Retention %"
                                                   Minimum="0" Maximum="20" SmallChange="0.5" SpinButtonPlacementMode="Compact"/>
                                    </Grid>
                                    <TextBox x:Name="ContractorAddressBox" Header="Contractor address"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"/>
                                    <TextBox x:Name="ScopeBox" Header="Scope of work"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                                    <!-- Lump sum -->
                                    <NumberBox x:Name="LumpSumBox" Header="Contract value (lump sum)"
                                               Minimum="0" SpinButtonPlacementMode="Hidden"/>

                                    <!-- Item rate lines -->
                                    <StackPanel x:Name="LinesPanel" Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Priced items" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Add line" Click="AddLine_Click" AutomationProperties.Name="Add contract line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Add from rates" Click="AddFromRates_Click" AutomationProperties.Name="Add line from rate book" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Delete line" Click="DeleteLine_Click" AutomationProperties.Name="Delete contract line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                           SelectionMode="Single" MinHeight="140" MaxHeight="260"
                                                           CellEditEnded="LinesGrid_CellEditEnded">
                                            <controls:DataGrid.Columns>
                                                <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*"/>
                                                <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="70"/>
                                                <controls:DataGridTextColumn Header="Qty" Binding="{Binding QtyText, Mode=TwoWay}" Width="80"/>
                                                <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="90"/>
                                                <controls:DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" IsReadOnly="True" Width="110"/>
                                            </controls:DataGrid.Columns>
                                        </controls:DataGrid>
                                        <TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Total: 0.00"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Terms &amp; conditions (one clause per line)" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <Button Grid.Column="1" Content="Add standard term" Click="AddTerm_Click" AutomationProperties.Name="Add standard term"
                                                    Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                        </Grid>
                                        <TextBox x:Name="TermsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
                                    </StackPanel>

                                    <InfoBar x:Name="LockBar" IsOpen="False" IsClosable="False" Severity="Informational"
                                             Title="Finalized" Message="This contract is finalized and numbered. Editing is locked; use Export PDF."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Schedule of rates -->
            <PivotItem Header="Schedule of rates">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add rate" Click="AddRate_Click" AutomationProperties.Name="Add contract rate" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Delete rate" Click="DeleteRate_Click" AutomationProperties.Name="Delete contract rate" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Unit-rate library used to add priced items to contracts."/>
                    </StackPanel>
                    <controls:DataGrid Grid.Row="1" x:Name="RatesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=TwoWay}" Width="110"/>
                            <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="3*"/>
                            <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="80"/>
                            <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Terms library -->
            <PivotItem Header="Terms library">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add" Click="AddTermLib_Click" AutomationProperties.Name="Add term to library" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Delete" Click="DeleteTermLib_Click" AutomationProperties.Name="Delete term from library" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}">
                            <ListView x:Name="TermsList" SelectionMode="Single" SelectionChanged="TermsList_SelectionChanged"
                                      DisplayMemberPath="Title"/>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="TermTitleBox" Header="Clause title" LostFocus="TermField_LostFocus"/>
                            <TextBox x:Name="TermTextBox" Header="Clause text" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="240" LostFocus="TermField_LostFocus"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
