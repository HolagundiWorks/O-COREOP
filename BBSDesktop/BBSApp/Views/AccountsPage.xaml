<Page
    x:Class="BBSApp.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Accounts" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Running-account bills, cash book, and party ledgers."/>
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="MainPivot" SelectionChanged="Pivot_Changed">
            <!-- Running bills -->
            <PivotItem Header="Running bills">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="New RA bill" Click="NewBill_Click" AutomationProperties.Name="New running-account bill" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Save" Click="SaveBill_Click" AutomationProperties.Name="Save running-account bill" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Certify locally" Click="CertifyBill_Click" AutomationProperties.Name="Certify and number bill locally" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTipService.ToolTip="Interim local lock and number only. Suite approval is in O-Studio (Practice → Approvals)."/>
                        <Button Content="Share draft to O-Studio" Click="ShareDraft_Click" AutomationProperties.Name="Share RA bill draft to O-Studio" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Revise" Click="ReviseBill_Click" AutomationProperties.Name="Revise certified bill" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTipService.ToolTip="Open a certified bill for correction as its next revision. It keeps its number and must be certified again."/>
                        <Button Content="Issue payment certificate" Click="IssueCertificate_Click" AutomationProperties.Name="Issue payment certificate" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTipService.ToolTip="Create a PM-issued Interim Payment Certificate in Office → Correspondence for this bill"/>
                        <Button Content="Export PDF" Click="ExportBill_Click" AutomationProperties.Name="Export bill PDF" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeleteBill_Click" AutomationProperties.Name="Delete running-account bill" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBox x:Name="PrefixBox" Header="Doc prefix" Width="110" PlaceholderText="auto" LostFocus="Prefix_LostFocus"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                            <ListView x:Name="BillList" SelectionMode="Single" SelectionChanged="BillList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Padding="2,4">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="EditorPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CalendarDatePicker x:Name="BillDateBox" Grid.Column="0" Header="Bill date" MinWidth="150"/>
                                        <ComboBox x:Name="ContractBox" Grid.Column="1" Header="Against contract / work order"
                                                  HorizontalAlignment="Stretch" SelectionChanged="ContractBox_SelectionChanged"/>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="Number" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <TextBlock x:Name="NumberText" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="PartyBox" Header="Contractor / party"/>
                                    <ComboBox x:Name="BillPhaseBox" Header="Running bill phase" HorizontalAlignment="Stretch" IsEditable="True"
                                              AutomationProperties.Name="Running bill phase this bill covers"
                                              ToolTipService.ToolTip="The running-bill phase this bill covers (the names come from the phases chosen in O-Draft). Optional."/>

                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Measured work" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryStyle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Add line" Click="AddLine_Click" AutomationProperties.Name="Add bill line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Import from contract" Click="ImportFromContract_Click" AutomationProperties.Name="Import lines from contract" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                                <Button Content="Delete line" Click="DeleteLine_Click" AutomationProperties.Name="Delete bill line" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                                           GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                           SelectionMode="Single" MinHeight="150" MaxHeight="260"
                                                           CellEditEnded="LinesGrid_CellEditEnded">
                                            <controls:DataGrid.Columns>
                                                <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*"/>
                                                <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="70"/>
                                                <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="90"/>
                                                <controls:DataGridTextColumn Header="Qty" Binding="{Binding QtyText, Mode=TwoWay}" Width="90"/>
                                                <controls:DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" IsReadOnly="True" Width="110"/>
                                            </controls:DataGrid.Columns>
                                        </controls:DataGrid>
                                    </StackPanel>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="RetentionBox" Grid.Column="0" Header="Retention %" Minimum="0" Maximum="20"
                                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Deduction_Changed"/>
                                        <NumberBox x:Name="OtherDeductBox" Grid.Column="1" Header="Other deductions" Minimum="0"
                                                   SpinButtonPlacementMode="Hidden" ValueChanged="Deduction_Changed"/>
                                        <NumberBox x:Name="AdvanceBox" Grid.Column="2" Header="Advance recovery" Minimum="0"
                                                   SpinButtonPlacementMode="Hidden" ValueChanged="Deduction_Changed"/>
                                    </Grid>

                                    <TextBlock Text="Statutory (India)" Style="{StaticResource CaptionSecondaryStyle}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="GstBox" Grid.Column="0" Header="GST % (add)" Minimum="0" Maximum="28"
                                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Deduction_Changed"
                                                   ToolTipService.ToolTip="Output GST added on taxable value (CGST+SGST or IGST)"/>
                                        <NumberBox x:Name="TdsBox" Grid.Column="1" Header="TDS 194C %" Minimum="0" Maximum="10"
                                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Deduction_Changed"
                                                   ToolTipService.ToolTip="Income-tax TDS on gross (1% individual / 2% company)"/>
                                        <NumberBox x:Name="CessBox" Grid.Column="2" Header="Labour cess %" Minimum="0" Maximum="5"
                                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Deduction_Changed"
                                                   ToolTipService.ToolTip="Building &amp; other construction workers' welfare cess on gross (typically 1%)"/>
                                        <NumberBox x:Name="GstTdsBox" Grid.Column="3" Header="GST-TDS %" Minimum="0" Maximum="5"
                                                   SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="Deduction_Changed"
                                                   ToolTipService.ToolTip="GST-TDS on taxable value (2% where applicable)"/>
                                    </Grid>

                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="GrossText" Text="Gross: 0.00"/>
                                            <TextBlock x:Name="DeductText" Text="Deductions: 0.00" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="NetText" Text="Net payable: 0.00" FontWeight="SemiBold" FontSize="16"/>
                                        </StackPanel>
                                    </Border>

                                    <InfoBar x:Name="LockBar" IsOpen="False" IsClosable="False" Severity="Success"
                                             Title="Certified" Message="This RA bill is certified and numbered. Editing is locked; use Export PDF."/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Cash book -->
            <PivotItem Header="Cash book">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <NumberBox x:Name="OpeningCashBox" Header="Opening cash" SpinButtonPlacementMode="Hidden" Width="150" ValueChanged="Opening_Changed"/>
                        <NumberBox x:Name="OpeningBankBox" Header="Opening bank" SpinButtonPlacementMode="Hidden" Width="150" ValueChanged="Opening_Changed"/>
                        <Button Content="Add receipt" Click="AddReceipt_Click" AutomationProperties.Name="Add cash receipt" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Add payment" Click="AddPayment_Click" AutomationProperties.Name="Add cash payment" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Delete" Click="DeleteTxn_Click" AutomationProperties.Name="Delete cash transaction" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock x:Name="CashSummary" Text="—"/>
                    </Border>
                    <controls:DataGrid Grid.Row="2" x:Name="TxnGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single"
                                       CellEditEnded="TxnGrid_CellEditEnded">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Date" Binding="{Binding DateText, Mode=TwoWay}" Width="100"/>
                            <controls:DataGridTextColumn Header="Type (R/P)" Binding="{Binding KindText, Mode=TwoWay}" Width="90"/>
                            <controls:DataGridTextColumn Header="Account" Binding="{Binding AccountText, Mode=TwoWay}" Width="90"/>
                            <controls:DataGridTextColumn Header="Party" Binding="{Binding Party, Mode=TwoWay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=TwoWay}" Width="130"/>
                            <controls:DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=TwoWay}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Amount" Binding="{Binding AmountText, Mode=TwoWay}" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Ledger -->
            <PivotItem Header="Ledger">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="LedgerPartyBox" Header="Party" MinWidth="240" SelectionChanged="LedgerParty_Changed"/>
                        <Button Content="Refresh" Click="LedgerRefresh_Click" AutomationProperties.Name="Refresh party ledger" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock x:Name="LedgerSummary" Text="Select a party to see its statement."/>
                    </Border>
                    <controls:DataGrid Grid.Row="2" x:Name="LedgerGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110"/>
                            <controls:DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Billed / due" Binding="{Binding ReceiptText}" Width="120"/>
                            <controls:DataGridTextColumn Header="Paid" Binding="{Binding PaymentText}" Width="120"/>
                            <controls:DataGridTextColumn Header="Balance payable" Binding="{Binding BalanceText}" Width="140"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
