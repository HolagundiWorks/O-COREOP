<Page
    x:Class="BBSApp.Views.CorrespondencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Correspondence" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Letters, memos, notices, certificates and site instructions — auto-numbered on finalize."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ComboBox x:Name="NewTypeBox" Header="New document" MinWidth="170"/>
            <Button Content="New" Click="New_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Finalize &amp; number" Click="Finalize_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Export PDF" Click="ExportPdf_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <Button Content="Delete" Click="Delete_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
            <TextBox x:Name="PrefixBox" Header="Doc prefix" Width="120"
                     PlaceholderText="auto" ToolTipService.ToolTip="Numbering prefix (blank = company initials)"
                     LostFocus="Prefix_LostFocus" VerticalAlignment="Bottom"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Register -->
            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
                <ListView x:Name="DocList" SelectionMode="Single" SelectionChanged="DocList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1" Padding="2,4">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel" Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TypeBox" Grid.Column="0" Header="Type" HorizontalAlignment="Stretch"
                                      SelectionChanged="TypeBox_SelectionChanged"/>
                            <CalendarDatePicker x:Name="DatePicker" Grid.Column="1" Header="Date" MinWidth="150"/>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Number" Style="{StaticResource CaptionSecondaryStyle}"/>
                                <TextBlock x:Name="NumberText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ToPanel" Spacing="10">
                            <TextBox x:Name="ToNameBox" Header="To (name / designation)"
                                     PlaceholderText="The Executive Engineer …"/>
                            <TextBox x:Name="ToAddressBox" Header="To (address)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                        </StackPanel>

                        <TextBox x:Name="SubjectBox" Header="Subject"/>

                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Body" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionSecondaryStyle}"/>
                                <Button Grid.Column="1" Content="Insert template" Click="Template_Click"
                                        Style="{StaticResource ToolbarButtonStyle}" Padding="8,2"/>
                            </Grid>
                            <TextBox x:Name="BodyBox" AutomationProperties.Name="Text of the letter" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"
                                     FontFamily="Consolas"/>
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SignNameBox" Grid.Column="0" Header="Signatory name"
                                     PlaceholderText="(defaults to prepared-by)"/>
                            <TextBox x:Name="SignRoleBox" Grid.Column="1" Header="Signatory designation"
                                     PlaceholderText="Engineer / Partner / PMC"/>
                        </Grid>

                        <InfoBar x:Name="LockBar" IsOpen="False" IsClosable="False"
                                 Severity="Informational"
                                 Title="Finalized"
                                 Message="This document is finalized and numbered. Editing is locked; use Export PDF to print."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
