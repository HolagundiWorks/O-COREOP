<Page
    x:Class="BBSApp.Views.RateBookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Rate book" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Versioned unit rates (app library). Clone a version, edit rates, then use Estimate → Calculate."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="New version" Style="{StaticResource SecondaryButtonStyle}"
                        Click="NewVersion_Click" AutomationProperties.Name="New rate book version"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" AutomationProperties.Name="Save rate book"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FluentCardCompactStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="VersionCombo" Header="Version" HorizontalAlignment="Stretch"
                          SelectionChanged="VersionCombo_SelectionChanged"
                          AutomationProperties.Name="Rate book version"/>
                <TextBox x:Name="NotesBox" Grid.Column="1" Header="Version notes"
                         PlaceholderText="Optional notes for this rate schedule"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardCompactStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ItemCombo" Header="Item code" HorizontalAlignment="Stretch"
                          SelectionChanged="ItemCombo_SelectionChanged"/>
                <TextBox x:Name="EditDsrBox" Grid.Column="1" Header="DSR item no." PlaceholderText="as in your schedule"
                         AutomationProperties.Name="DSR item number"/>
                <TextBox x:Name="EditDescBox" Grid.Column="2" Header="Description"/>
                <NumberBox x:Name="EditRateBox" Grid.Column="3" Header="Rate"
                           SpinButtonPlacementMode="Compact" Minimum="0"/>
                <Button Grid.Column="4" Content="Apply" VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ApplyRow_Click"
                        Margin="0,0,0,4"/>
            </Grid>
        </Border>

        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False"/>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="8">
            <Border x:Name="TableHost"/>
        </Border>
    </Grid>
</Page>
