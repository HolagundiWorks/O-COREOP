<Page
    x:Class="BBSApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource HcwFogBrush}">
    <ScrollViewer>
        <StackPanel Spacing="16"
                    MaxWidth="960"
                    Padding="{StaticResource PagePadding}"
                    Transitions="{StaticResource PageContentTransitions}">

            <!-- Soft brief — brand -->
            <Grid>
                <Border CornerRadius="8" Background="{ThemeResource HcwNeuDarkBrush}" Margin="6,6,0,0"/>
                <Border CornerRadius="8" Background="{ThemeResource HcwNeuLightBrush}" Margin="0,0,6,6"/>
                <Border CornerRadius="8" Background="{ThemeResource HcwSoftBrush}" Padding="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="8"
                                Background="{ThemeResource HcwWhiteBrush}"
                                VerticalAlignment="Top">
                            <Image Stretch="Uniform" Margin="5"
                                   AutomationProperties.Name="O-CoreOp logo">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/mark.svg"/>
                                </Image.Source>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandNameText" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock x:Name="BrandFullText" Style="{StaticResource PageSubtitleStyle}"/>
                            <TextBlock x:Name="BrandTaglineText" Style="{StaticResource CaptionSecondaryStyle}"/>
                            <TextBlock x:Name="BrandByText" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Current project" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongStyle}" Margin="0"/>
                    <TextBlock x:Name="MetaText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CountsText" Style="{StaticResource CaptionSecondaryStyle}"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4" Transitions="{StaticResource CardContentTransitions}">
                <TextBlock Text="Latest steel summary" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                           Text="Generate on an element page or open Purchase orders for full material totals."/>
                <Border Style="{StaticResource FluentCardStyle}" Padding="4" Margin="0,2,0,0" MinHeight="180">
                    <Border x:Name="SummaryHost"/>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource FluentCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Take-off" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                               Text="Project › Take-off (O-Draft): drawings are measured in O-Draft and recorded in the project file; read the take-off here, review, then import. Formwork is auto from RCC. Yields and beam–slab deduct are under Settings. Open Quantities for a concrete / formwork / steel preview."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="BrandCopyrightText" Style="{StaticResource MetaTextStyle}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
