<Page
    x:Class="BBSApp.Views.EstimatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="780" HorizontalAlignment="Left">
                <TextBlock Text="Generate estimate" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Abstract of cost in DSR format (Sl. No., Item code, Description, Unit, Qty, Rate, Amount). Pick rate book version → Calculate."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Calculate" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Calculate_Click" AutomationProperties.Name="Calculate estimate"/>
                <Button Content="Export PDF" Style="{StaticResource AccentButtonStyle}"
                        Click="ExportPdf_Click" AutomationProperties.Name="Export estimate PDF"/>
                <Button Content="CSV" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportCsv_Click" AutomationProperties.Name="Export estimate CSV"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Storeys" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Style="{StaticResource FluentCardCompactStyle}">
                <Grid ColumnSpacing="{StaticResource SpacingM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LevelChecks" Orientation="Horizontal" Spacing="8"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton MinHeight="28" MinWidth="40" Content="All" Click="SelectAllLevels_Click"/>
                        <HyperlinkButton MinHeight="28" MinWidth="40" Content="None" Click="SelectNoLevels_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource FluentCardCompactStyle}">
            <Grid ColumnSpacing="12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="VersionCombo" Header="Rate book version" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Rate book version for estimate"/>
                <TextBlock x:Name="TotalText" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
                           Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                <TextBlock x:Name="MarkupText" Grid.Row="1" Grid.ColumnSpan="2"
                           Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                           Text="Set electrical / plumbing / escalation / fees under File → Cost percentages."/>
            </Grid>
        </Border>

        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False"/>

        <Grid Grid.Row="4" ColumnSpacing="{StaticResource SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="CivilTitle" Text="Civil / finishes / doors / windows"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="CivilHost"/>
                </Border>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SteelTitle" Text="Steel"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="SteelHost"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="MatTitle" Text="Materials"
                       Style="{StaticResource SectionHeaderStyle}"/>
            <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="8">
                <Border x:Name="MatHost"/>
            </Border>
        </Grid>
    </Grid>
</Page>
