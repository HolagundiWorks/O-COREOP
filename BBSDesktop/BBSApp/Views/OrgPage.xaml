<Page
    x:Class="BBSApp.Views.OrgPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Organisation &amp; resources" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"
                       Text="Sites, resources, employees, attendance and payroll."/>
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="MainPivot" SelectionChanged="Pivot_Changed">
            <!-- Sites -->
            <PivotItem Header="Sites">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add site" Click="AddSite_Click" AutomationProperties.Name="Add site" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeleteSite_Click" AutomationProperties.Name="Delete site" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <controls:DataGrid Grid.Row="1" x:Name="SitesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Location" Binding="{Binding Location, Mode=TwoWay}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Site manager" Binding="{Binding Manager, Mode=TwoWay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=TwoWay}" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Resources -->
            <PivotItem Header="Resources">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add resource" Click="AddResource_Click" AutomationProperties.Name="Add resource" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeleteResource_Click" AutomationProperties.Name="Delete resource" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Kind: Labour / Plant / Material."/>
                    </StackPanel>
                    <controls:DataGrid Grid.Row="1" x:Name="ResourcesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=TwoWay}" Width="120"/>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="3*"/>
                            <controls:DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=TwoWay}" Width="90"/>
                            <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Employees -->
            <PivotItem Header="Employees">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add employee" Click="AddEmployee_Click" AutomationProperties.Name="Add employee" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Delete" Click="DeleteEmployee_Click" AutomationProperties.Name="Delete employee" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Style="{StaticResource CaptionSecondaryStyle}" VerticalAlignment="Center"
                                   Text="Wage type: Monthly (salary) or Daily (wage). Site = existing site name."/>
                    </StackPanel>
                    <controls:DataGrid Grid.Row="1" x:Name="EmployeesGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=TwoWay}" Width="90"/>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay}" Width="2*"/>
                            <controls:DataGridTextColumn Header="Designation" Binding="{Binding Designation, Mode=TwoWay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Site" Binding="{Binding Site, Mode=TwoWay}" Width="*"/>
                            <controls:DataGridTextColumn Header="Wage type" Binding="{Binding WageType, Mode=TwoWay}" Width="100"/>
                            <controls:DataGridTextColumn Header="Rate" Binding="{Binding RateText, Mode=TwoWay}" Width="110"/>
                            <controls:DataGridTextColumn Header="Phone" Binding="{Binding Phone, Mode=TwoWay}" Width="130"/>
                            <controls:DataGridTextColumn Header="Active" Binding="{Binding ActiveText, Mode=TwoWay}" Width="80"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Payroll -->
            <PivotItem Header="Payroll">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBox x:Name="MonthBox" Header="Month (yyyy-MM)" Width="130"/>
                        <NumberBox x:Name="WorkingDaysBox" Header="Working days" Width="120" Minimum="1" Maximum="31"
                                   SpinButtonPlacementMode="Compact" ValueChanged="WorkingDays_Changed"/>
                        <Button Content="Load" Click="LoadPayroll_Click" AutomationProperties.Name="Load payroll" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
                        <Button Content="Export PDF" Click="ExportPayroll_Click" AutomationProperties.Name="Export payroll PDF" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock x:Name="PayrollSummary" Text="Enter month and click Load."/>
                    </Border>
                    <controls:DataGrid Grid.Row="2" x:Name="PayrollGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                                       GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single"
                                       CellEditEnded="PayrollGrid_CellEditEnded">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="90"/>
                            <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <controls:DataGridTextColumn Header="Designation" Binding="{Binding Designation}" IsReadOnly="True" Width="*"/>
                            <controls:DataGridTextColumn Header="Basis" Binding="{Binding Basis}" IsReadOnly="True" Width="140"/>
                            <controls:DataGridTextColumn Header="Days present" Binding="{Binding DaysText, Mode=TwoWay}" Width="110"/>
                            <controls:DataGridTextColumn Header="Gross" Binding="{Binding GrossText}" IsReadOnly="True" Width="120"/>
                            <controls:DataGridTextColumn Header="Advance" Binding="{Binding AdvanceText, Mode=TwoWay}" Width="110"/>
                            <controls:DataGridTextColumn Header="Net" Binding="{Binding NetText}" IsReadOnly="True" Width="120"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
