<Page
    x:Class="BBSApp.Views.QuantitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Quantities preview" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Concrete m³ · formwork m² · steel kg by storey — check before purchase order or PDF."/>
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Refresh_Click" AutomationProperties.Name="Refresh quantities"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FluentCardCompactStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LevelChecks" Orientation="Horizontal" Spacing="8"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton MinHeight="28" MinWidth="40" Content="All" Click="SelectAll_Click" AutomationProperties.Name="Select all quantity sheets"/>
                    <HyperlinkButton MinHeight="28" MinWidth="40" Content="None" Click="SelectNone_Click" AutomationProperties.Name="Clear quantity sheet selection"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Concrete" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="ConcreteTotal" Grid.Row="1" Style="{StaticResource CaptionSecondaryStyle}"/>
                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="4" MinHeight="200">
                    <Border x:Name="ConcreteHost"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Formwork / shuttering" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="ShutterTotal" Grid.Row="1" Style="{StaticResource CaptionSecondaryStyle}"/>
                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="4" MinHeight="200">
                    <Border x:Name="ShutterHost"/>
                </Border>
            </Grid>

            <Grid Grid.Column="2" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Steel (last BBS)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="SteelTotal" Grid.Row="1" Style="{StaticResource CaptionSecondaryStyle}"/>
                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="4" MinHeight="200">
                    <Border x:Name="SteelHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
