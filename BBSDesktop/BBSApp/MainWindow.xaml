<Window
    x:Class="BBSApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hcw="using:Hcw.Ui.Controls"
    Title="O-CoreOp">

    <!--
      Shell, the same structure as AOS:
      Caption (OS drag) ? document title only
      MenuBar row ? File · Edit · Help
      Left navigation pane ? the sections, grouped by job
      Work area ? page line, page, status strip, floating widgets
    -->
    <Grid Language="en-US" Background="{ThemeResource HcwFogBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Caption — OS drag only (no MenuBar, no second brand name) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="12,0,140,0"
              Background="{ThemeResource HcwFogBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Width="18" Height="18" CornerRadius="2"
                        Background="{ThemeResource HcwSoftBrush}">
                    <Image Stretch="Uniform" Margin="1"
                           AutomationProperties.Name="O-CoreOp"
                           AutomationProperties.AccessibilityView="Raw">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/mark.svg"/>
                        </Image.Source>
                    </Image>
                </Border>
                <TextBlock x:Name="TitleBarText" Text="Untitled Project" FontSize="12"
                           FontFamily="{StaticResource HcwFontFamily}"
                           Foreground="{ThemeResource HcwInkBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="480"/>
            </StackPanel>
        </Grid>

        <!-- Shell at 1× (kept so a scale can be applied again) — layout size compensated in ScaleViewport_SizeChanged -->
        <Grid x:Name="ScaleViewport" Grid.Row="1" SizeChanged="ScaleViewport_SizeChanged"
              Background="{ThemeResource HcwFogBrush}">
            <Grid x:Name="ScaleHost" HorizontalAlignment="Left" VerticalAlignment="Top"
                  RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

        <!-- Suite menu strip — flat like O-Studio (File · Edit · Help). -->
        <MenuBar x:Name="AppMenuBar" Grid.Row="0" Height="{StaticResource SuiteMenuBarHeight}" VerticalAlignment="Center"
                 Background="{ThemeResource HcwSoftBrush}"
                 Foreground="{ThemeResource HcwInkBrush}"
                 FontSize="{StaticResource SuiteFontBody}"
                 AutomationProperties.Name="Menu bar">
            <!-- Company first ? work ? Exit (same File shape as O-Studio / OSAS). -->
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="Open company from OSAS…" Click="CompanyOpen_Click" AccessKey="O">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Company projects…" Click="CompanyProjects_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close company" Click="CompanyClose_Click" AccessKey="C">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New project" Click="New_Click" AccessKey="N">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open…" Click="Open_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save" Click="Save_Click" AccessKey="S">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save as…" Click="SaveAs_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE792;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save to company file…" Click="CompanySaveHere_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Take-off from ShilpiDB…" Click="NavMenu_Click" Tag="takeoff">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Import from CAD…" Click="ImportCad_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B5;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Export for CAD…" Click="ExportCad_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEDE1;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Undo last CAD import" Click="UndoCadImport_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" AccessKey="X">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Edit" AccessKey="E">
                <MenuFlyoutItem Text="Project settings…" Click="NavMenu_Click" Tag="settings_project">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Engineering settings…" Click="NavMenu_Click" Tag="settings_engineering">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Cost percentages…" Click="NavMenu_Click" Tag="settings_cost">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE1D0;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="Check for updates…" Click="CheckForUpdates_Click" AccessKey="U">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE895;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="About" Click="About_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>


        <!-- A menu bar, then two ribbons of text tabs (main: the sections; sub: the pages of the open section), then the work area.
             The open tab of each ribbon is the colour of what lies below it, so it joins the sub ribbon or the canvas without a line. -->
        <Grid x:Name="AppNav" Grid.Row="1" Background="{ThemeResource HcwFogBrush}" AutomationProperties.Name="Sections">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="MainRibbon" Grid.Row="0" Background="{ThemeResource HcwSoftBrush}" AutomationProperties.Name="Main menu">
                <Border x:Name="MainRibbonLine" Height="1" VerticalAlignment="Bottom" Background="{ThemeResource HcwEdgeBrush}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                    <StackPanel x:Name="MainRibbonTabs" Orientation="Horizontal" Margin="12,6,12,0"/>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="SubRibbon" Grid.Row="1" Background="{ThemeResource HcwWhiteBrush}" AutomationProperties.Name="Sub menu">
                <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource HcwEdgeBrush}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                    <StackPanel x:Name="SubRibbonTabs" Orientation="Horizontal" Margin="12,6,12,0"/>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="WorkArea" Grid.Row="2" Background="{ThemeResource HcwFogBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page line: the page, and whose letterhead the project is set up for -->
                <StackPanel x:Name="PageLine" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="24,12,24,4">
                    <TextBlock x:Name="RibbonPageLabel" Text="Dashboard" AutomationProperties.HeadingLevel="Level1" FontSize="{StaticResource SuiteFontSection}" FontWeight="SemiBold"
                               FontFamily="{StaticResource HcwFontFamily}" Foreground="{ThemeResource HcwInkBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PersonaPageSep" Text="·" Foreground="{ThemeResource HcwMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PersonaBadgeText" FontSize="12" Foreground="{ThemeResource HcwMutedBrush}"
                               VerticalAlignment="Center" ToolTipService.ToolTip="Active persona — Edit › Project settings"/>
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="2" Margin="20,0,20,12">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <!-- Cleared at runtime when system animations are off (SuiteMotion). -->
                            <NavigationThemeTransition/>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>

                <!-- Floating Ask bar (as in O-Draft): fixed bottom-centre over the page, solid pill, reply card above it. -->
                <StackPanel x:Name="AiBar" Grid.Row="2" Spacing="6" Margin="0,0,0,24" Width="520"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            AutomationProperties.Name="Ask the assistant">
                    <Border x:Name="AiReplyHost" Visibility="Collapsed" CornerRadius="12" Padding="12,8"
                            Background="{ThemeResource HcwWhiteBrush}" BorderBrush="{ThemeResource HcwEdgeBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="AssistantReply" FontSize="{StaticResource SuiteFontBody}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource HcwInkBrush}" IsTextSelectionEnabled="True"/>
                            </ScrollViewer>
                            <ProgressRing x:Name="AssistantBusy" IsActive="False" Visibility="Collapsed"
                                          Width="20" Height="20" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="AiPill" Height="40" CornerRadius="20" Padding="6,4"
                            Background="{ThemeResource HcwWhiteBrush}" BorderBrush="{ThemeResource HcwEdgeBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource HcwSoftBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="{StaticResource SuiteFontBody}" Foreground="{ThemeResource HcwMutedBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="AiInput" Grid.Column="1" BorderThickness="0" CornerRadius="0" Background="Transparent"
                                     FontSize="{StaticResource SuiteFontBody}" VerticalAlignment="Center"
                                     PlaceholderText="Ask about this project…" AcceptsReturn="False" TextWrapping="NoWrap"
                                     AutomationProperties.Name="Ask the assistant" KeyDown="AiInput_KeyDown">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="2" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" CornerRadius="16"
                                    Background="{ThemeResource HcwInkBrush}" BorderThickness="0" VerticalAlignment="Center"
                                    Click="AiSend_Click" AutomationProperties.Name="Send" ToolTipService.ToolTip="Send">
                                <FontIcon Glyph="&#xE898;" FontSize="{StaticResource SuiteIconSize}" Foreground="{ThemeResource HcwWhiteBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Status strip: calculator, theme, company chip -->
                <Border x:Name="StatusStrip" Grid.Row="4" Margin="16,0,16,12" Padding="12,0" Height="{StaticResource SuiteStatusBarHeight}"
                        Background="{ThemeResource HcwWhiteBrush}" BorderBrush="{ThemeResource HcwEdgeBrush}"
                        BorderThickness="0" CornerRadius="{StaticResource SuiteCornerControl}" AutomationProperties.Name="Status">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NavCalcBtn" AutomationProperties.Name="Calculator and ask" Style="{StaticResource HcwGhostButton}" MinWidth="40"
                                Click="CalcFab_Click" ToolTipService.ToolTip="Calculator · Ask" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE1D0;" FontSize="{StaticResource SuiteIconSize}" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <hcw:SuiteThemeSwitch x:Name="ThemeSwitch" VerticalAlignment="Center"/>
                            <Button x:Name="CompanyBadge" Style="{StaticResource HcwGhostButton}" Padding="12,0"
                                    Click="CompanyBadge_Click"
                                    AutomationProperties.Name="Company file"
                                    ToolTipService.ToolTip="The company file shared with O-Studio — open its projects">
                                <TextBlock x:Name="CompanyBadgeText" VerticalAlignment="Center" FontSize="{StaticResource SuiteFontBody}"
                                           Foreground="{ThemeResource HcwInkBrush}" MaxWidth="190" TextTrimming="CharacterEllipsis"
                                           Text="Company · not open"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- Soft toast — clears taskbar + clock -->
            <Grid x:Name="ToastHost" Grid.Row="1" Margin="24,0,24,8" HorizontalAlignment="Stretch"
                  MaxWidth="400" MinWidth="0"
                  Visibility="Collapsed"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="Notification">
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwNeuDarkBrush}" Margin="4,4,0,0"/>
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwNeuLightBrush}" Margin="0,0,4,4"/>
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwSoftBrush}" Padding="4">
                    <InfoBar x:Name="ToastBar"
                             IsOpen="False" IsClosable="True"
                             Background="Transparent" BorderThickness="0"
                             CloseButtonClick="ToastBar_CloseClick">
                        <InfoBar.Resources>
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="Transparent"/>
                        </InfoBar.Resources>
                    </InfoBar>
                </Border>
            </Grid>

            <!-- Calculator panel — left of clock, above taskbar -->
            <Grid x:Name="FloatingCalcPanel" Grid.Row="3" Margin="24,0,24,8"
                  MaxWidth="480" Visibility="Collapsed" HorizontalAlignment="Left"
                  AutomationProperties.Name="Floating calculator">
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwNeuDarkBrush}" Margin="5,5,0,0"/>
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwNeuLightBrush}" Margin="0,0,5,5"/>
                <Border CornerRadius="{StaticResource SuiteCornerControl}" Background="{ThemeResource HcwSoftBrush}" Padding="12">
                    <StackPanel Spacing="{StaticResource SuiteStackGap}">
                        <Grid>
                            <TextBlock Text="Calculator · Ask"
                                       FontSize="{StaticResource SuiteFontBody}" FontWeight="SemiBold"
                                       FontFamily="{StaticResource HcwFontFamily}"
                                       Foreground="{ThemeResource HcwInkBrush}"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource HcwGhostButton}"
                                    MinWidth="{StaticResource SuiteControlMinHeight}" Width="{StaticResource SuiteControlMinHeight}" Padding="0"
                                    Click="CalcClose_Click"
                                    AutomationProperties.Name="Close calculator"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource SuiteIconSize}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource HcwMutedBrush}"/>
                            </Button>
                        </Grid>
                        <TextBox x:Name="CalcInput"
                                 PlaceholderText="Calculate or ask a question"
                                 AutomationProperties.Name="Calculator or ask input"
                                 FontSize="{StaticResource SuiteFontBody}" MinHeight="{StaticResource SuiteControlMinHeight}"
                                 AcceptsReturn="False" TextWrapping="NoWrap"
                                 KeyDown="CalcInput_KeyDown"
                                 TextChanged="CalcInput_TextChanged"/>
                        <TextBox x:Name="CalcResult"
                                 PlaceholderText="Result"
                                 AutomationProperties.Name="Calculator result"
                                 FontSize="{StaticResource SuiteFontBody}" MinHeight="{StaticResource SuiteControlMinHeight}"
                                 IsReadOnly="True" AcceptsReturn="False"
                                 Foreground="{ThemeResource HcwAccentTextBrush}"/>
                        <TextBlock FontSize="11" Foreground="{ThemeResource HcwMutedBrush}"
                                   Text="Enter to calculate · anything else goes to the Ask bar"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hidden FAB peer — code still references CalcFab for focus -->
            <Button x:Name="CalcFab" Visibility="Collapsed" Click="CalcFab_Click"/>
            </Grid>
        </Grid>
                </Grid><!-- scale inner -->
            </Grid><!-- ScaleHost -->
        </Grid><!-- ScaleViewport -->
    </Grid><!-- root -->
</Window>
