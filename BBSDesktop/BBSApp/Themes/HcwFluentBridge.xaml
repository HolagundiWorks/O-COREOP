<!--
  Bridge Fluent ThemeResource keys → OSAS glass soft-UI (SuiteColors) + O-CoreOp blue accent.
  Merged after XamlControlsResources + HcwTheme so pages using ThemeResource
  Card*/Layer*/Text*/Accent* pick up the cool stage, frost, white cards and navy ink.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A2332"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A52B8"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#E4EAF2"/>
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A2332"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A52B8"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#E4EAF2"/>
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
        </ResourceDictionary>
        <!-- Product stays light-first glass soft-UI even if the system asks for dark. -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E4EAF2"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A2332"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F1F5FA"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8DEE8"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A52B8"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1F5FD1"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#EEF2F8"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#E4EAF2"/>
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
